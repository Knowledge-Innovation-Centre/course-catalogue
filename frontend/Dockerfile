FROM node:20-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install

RUN npm i -g serve

COPY . .

ARG VITE_MEILISEARCH_HOST
ARG VITE_MEILISEARCH_KEY
ARG VITE_MEILISEARCH_INDEX

ENV VITE_MEILISEARCH_HOST=$VITE_MEILISEARCH_HOST
ENV VITE_MEILISEARCH_KEY=$VITE_MEILISEARCH_KEY
ENV VITE_MEILISEARCH_INDEX=$VITE_MEILISEARCH_INDEX

RUN npm run build

EXPOSE 3000

CMD ["serve", "-s", "dist"]
